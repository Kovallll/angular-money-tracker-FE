{
  "name": "moneytracker",
  "version": "0.0.0",
  "packageManager": "yarn@4.13.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/sync-env-config.js && ng serve",
    "start:spa": "node scripts/sync-env-config.js && ng serve --configuration spa",
    "build": "node scripts/sync-env-config.js && node scripts/generate-ngsw-config.js && ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json,md}\"",
    "prepare": "husky",
    "build:mobile": "node scripts/sync-env-config.js && node scripts/generate-ngsw-config.js && ng build",
    "cap:copy": "npx cap copy",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "yarn build:mobile && yarn cap:icons && npx cap copy  && npx cap open android",
    "cap:run:ios": "yarn build:mobile && yarn cap:icons && npx cap copy && npx cap open ios",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:icons": "npx @capacitor/assets generate --iconBackgroundColor #0f1d39 --iconBackgroundColorDark #0f172a --splashBackgroundColor #0f1d39 --splashBackgroundColorDark #0f172a"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.4",
    "@angular/cdk": "^20.2.0",
    "@angular/common": "^20.1.0-next",
    "@angular/compiler": "^20.1.0-next",
    "@angular/forms": "^20.1.0-next",
    "@angular/material": "^20.2.0",
    "@angular/platform-browser": "^20.1.0-next",
    "@angular/platform-browser-dynamic": "^20.3.7",
    "@angular/router": "^20.1.0-next",
    "@angular/service-worker": "20.3",
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@primeuix/styled": "^0.7.4",
    "@primeuix/themes": "^1.2.5",
    "@primeuix/utils": "^0.6.1",
    "@tanstack/angular-query-experimental": "^5.90.7",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.18",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "ng2-charts": "^8.0.0",
    "pdfmake": "^0.3.4",
    "prettier": "^3.6.2",
    "primeicons": "^7.0.0",
    "primeng": "^20.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-architects/module-federation": "^20.0.0",
    "@angular-builders/custom-webpack": "20.0.0",
    "@angular-eslint/builder": "^20.3.0",
    "@angular-eslint/eslint-plugin": "^20.3.0",
    "@angular-eslint/eslint-plugin-template": "^20.3.0",
    "@angular-eslint/schematics": "^20.3.0",
    "@angular-eslint/template-parser": "^20.2.0",
    "@angular/build": "^20.1.0-next",
    "@angular/cli": "20.3",
    "@angular/compiler-cli": "^20.1.0-next",
    "@angular/core": "20.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.0.0",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "sass": "^1.92.0",
    "systemjs-webpack-interop": "^2.3.7",
    "ts-node": "~10.9.0",
    "typescript": "~5.8.0"
  }
}
